<UserControl x:Class="PCVerwaltung.KundenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titelbereich -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="AccountGroup" Width="28" Height="28" Margin="0,0,8,0"
                                     VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Kundenstammdaten &amp; Bonitätsranking pflegen (US-04 / UC 003)"
                       FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 1. Eingabe- & Bearbeitungsmaske (CRUD) -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Modus-Anzeige -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <materialDesign:PackIcon x:Name="IconFormMode" Kind="AccountPlus" Width="20" Height="20"
                                             Margin="0,0,6,0" VerticalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock x:Name="TxtFormMode" Text="Neuen Kunden erfassen"
                               FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Zeile 1: Vorname, Nachname, Bonitätsranking -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Vorname *:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtVorname"
                                 materialDesign:HintAssist.Hint="z. B. Maximilian"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="Nachname *:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNachname"
                                 materialDesign:HintAssist.Hint="z. B. Berger"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="Bonitätsranking *:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbRanking" SelectionChanged="OnRankingSelectionChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Zeile 2: Adresse, E-Mail, Telefon -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Anschrift (Straße, Hausnr., PLZ, Ort) *:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAdresse"
                                 materialDesign:HintAssist.Hint="z. B. Königstraße 24, 70173 Stuttgart"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="E-Mail-Adresse *:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEmail"
                                 materialDesign:HintAssist.Hint="z. B. name@beispiel.de"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="Telefonnummer *:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTelefon"
                                 materialDesign:HintAssist.Hint="z. B. +49 711 123456"/>
                    </StackPanel>
                </Grid>

                <!-- Zeile 3: Bonitäts-Hinweis & CRUD-Buttons -->
                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShieldCheck" Width="18" Height="18" Margin="0,0,6,0"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock x:Name="TxtRankingInfo"
                                   Text="Bonitätsstufe STANDARD: 5 % Barzahlungsrabatt | Ratenfinanzierung zulässig"
                                   FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnNew" Content="Neu / Zurücksetzen"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnNewClick" MinWidth="150" Height="34" Margin="0,0,8,0"/>
                        <Button x:Name="BtnDelete" Content="Löschen"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C62828" BorderBrush="#C62828"
                                Click="OnDeleteClick" MinWidth="110" Height="34" Margin="0,0,8,0"
                                IsEnabled="False"/>
                        <Button x:Name="BtnSave" Content="Kunde speichern"
                                Click="OnSaveClick" MinWidth="165" Height="34"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- 2. Kunden-Gesamtübersicht mit Suche -->
        <materialDesign:Card Grid.Row="2" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Gespeicherte Kunden (Zeile anklicken zum Bearbeiten oder Löschen):"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox x:Name="TxtSearch" Grid.Column="2"
                             materialDesign:HintAssist.Hint="Suche nach Name, E-Mail, Ort oder Ranking..."
                             TextChanged="OnSearchTextChanged" VerticalAlignment="Center"/>
                </Grid>

                <DataGrid x:Name="dgKunden" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Single" SelectionChanged="OnCustomerSelectionChanged"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"        Binding="{Binding FullName}"           Width="170" FontWeight="Medium"/>
                        <DataGridTextColumn Header="Ranking"     Binding="{Binding Ranking}"            Width="105" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Konditionen" Binding="{Binding KonditionenSummary}" Width="245"/>
                        <DataGridTextColumn Header="Anschrift"   Binding="{Binding Adresse}"            Width="240"/>
                        <DataGridTextColumn Header="E-Mail"      Binding="{Binding Email}"              Width="190"/>
                        <DataGridTextColumn Header="Telefon"     Binding="{Binding Telefon}"            Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
