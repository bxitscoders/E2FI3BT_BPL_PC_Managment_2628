<UserControl x:Class="PCVerwaltung.AllListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="950">
    <UserControl.Resources>
        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Übersicht aller Hardware-Komponenten und Systeme" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <TabControl Grid.Row="1">
            <!-- Cases -->
            <TabItem Header="Gehäuse">
                <DataGrid ItemsSource="{Binding Cases}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          EnableRowVirtualization="True" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hersteller"  Binding="{Binding Hersteller}" Width="1.5*" />
                        <DataGridTextColumn Header="Modell"      Binding="{Binding Modell}"     Width="2*" />
                        <DataGridTextColumn Header="Formfaktor"  Binding="{Binding Formfaktor}" Width="*" />
                        <DataGridTextColumn Header="EK-Preis"    Binding="{Binding EkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="VK-Preis"    Binding="{Binding VkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Mainboards -->
            <TabItem Header="Mainboards">
                <DataGrid ItemsSource="{Binding Mainboards}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          EnableRowVirtualization="True" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hersteller"  Binding="{Binding Hersteller}" Width="1.5*" />
                        <DataGridTextColumn Header="Modell"      Binding="{Binding Modell}"     Width="2*" />
                        <DataGridTextColumn Header="Formfaktor"  Binding="{Binding Formfaktor}" Width="*" />
                        <DataGridTextColumn Header="Sockel"      Binding="{Binding Sockel}"     Width="*" />
                        <DataGridTextColumn Header="RAM-Slots"   Binding="{Binding RamSlots}"   Width="0.8*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="EK-Preis"    Binding="{Binding EkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="VK-Preis"    Binding="{Binding VkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- CPUs -->
            <TabItem Header="CPUs">
                <DataGrid ItemsSource="{Binding CPUs}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          EnableRowVirtualization="True" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hersteller"  Binding="{Binding Hersteller}" Width="1.2*" />
                        <DataGridTextColumn Header="Modell"      Binding="{Binding Modell}"     Width="2*" />
                        <DataGridTextColumn Header="Sockel"      Binding="{Binding Sockel}"     Width="*" />
                        <DataGridTextColumn Header="Takt (GHz)"  Binding="{Binding Taktfrequenz, StringFormat={}{0:0.##} GHz}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="Kerne"       Binding="{Binding Kerne}"      Width="0.8*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="EK-Preis"    Binding="{Binding EkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="VK-Preis"    Binding="{Binding VkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- RAM -->
            <TabItem Header="RAM">
                <DataGrid ItemsSource="{Binding Rams}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          EnableRowVirtualization="True" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hersteller"  Binding="{Binding Hersteller}" Width="1.5*" />
                        <DataGridTextColumn Header="Modell"      Binding="{Binding Modell}"     Width="2*" />
                        <DataGridTextColumn Header="Typ"         Binding="{Binding Typ}"        Width="*" />
                        <DataGridTextColumn Header="Kapazität"   Binding="{Binding KapazitaetGB, StringFormat={}{0} GB}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="Takt (MHz)"  Binding="{Binding TaktfrequenzMHz, StringFormat={}{0} MHz}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="EK-Preis"    Binding="{Binding EkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="VK-Preis"    Binding="{Binding VkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- SSDs -->
            <TabItem Header="SSDs">
                <DataGrid ItemsSource="{Binding SSDs}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          EnableRowVirtualization="True" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hersteller"  Binding="{Binding Hersteller}" Width="1.5*" />
                        <DataGridTextColumn Header="Modell"      Binding="{Binding Modell}"     Width="2*" />
                        <DataGridTextColumn Header="Typ"         Binding="{Binding Typ}"        Width="*" />
                        <DataGridTextColumn Header="Kapazität"   Binding="{Binding KapazitaetGB, StringFormat={}{0} GB}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="Lesen (MB/s)" Binding="{Binding LesegeschwindigkeitMBs, StringFormat={}{0} MB/s}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="EK-Preis"    Binding="{Binding EkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="VK-Preis"    Binding="{Binding VkPreis, StringFormat={}{0:0.00} €}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- PCs -->
            <TabItem Header="PCs">
                <DataGrid ItemsSource="{Binding PCs}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          EnableRowVirtualization="True" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CPU"          Binding="{Binding Cpu.Modell}"         Width="2*" />
                        <DataGridTextColumn Header="Takt"         Binding="{Binding Cpu.Taktfrequenz, StringFormat={}{0:0.##} GHz}" Width="*" ElementStyle="{StaticResource RightAlignStyle}"/>
                        <DataGridTextColumn Header="Board"        Binding="{Binding Mainboard.Modell}"   Width="2*" />
                        <DataGridTextColumn Header="Formfaktor"   Binding="{Binding Mainboard.Formfaktor}" Width="*" />
                        <DataGridTextColumn Header="Sockel"       Binding="{Binding Mainboard.Sockel}"   Width="*" />
                        <DataGridTextColumn Header="Gehäuse"      Binding="{Binding Case.Modell}"        Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
